# Local development: copy this file to .env and use the start scripts.
# Never commit .env. A missing/invalid Gemini key automatically uses OCR + rules.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
LEDGER_STORAGE=local
# Optional locally. Required in cloud via Secret Manager.
LEDGER_SESSION_SECRET=
# Firebase web configuration is public project configuration, not a server credential.
# Leave blank to run the private demo without accounts.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
GOOGLE_CLOUD_PROJECT=
# Cloud mode only; provision through scripts/setup-cloud.sh and docs/DEPLOY.md.
LEDGER_BUCKET=
LEDGER_REGION=asia-south1
LEDGER_QUEUE=ledger-invoices
LEDGER_WORKER_URL=
LEDGER_TASK_SERVICE_ACCOUNT=
LEDGER_SERVICE=web
