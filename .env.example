# Set in the hosting dashboard or your shell. Never commit a real key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Optional local demo-only reset. Never enable on real records.
AP_DEMO_RESET=0
# Required on hosted/shared deployments. Browser asks for this token.
AP_ACCESS_TOKEN=
# Mount a persistent disk here when deploying.
AP_DATA_DIR=./data

GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# Absolute persistent directory for Streamlit saved-session archives.
# LEDGER_ARCHIVE_DIR=/persistent/ledger-archive
